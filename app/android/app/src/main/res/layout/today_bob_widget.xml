<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_bob_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="2dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <ImageView
        android:id="@+id/today_bob_widget_icon"
        android:layout_width="25dp"
        android:layout_height="27dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/tomato_gold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:text="" />

    <TextView
        android:id="@+id/today_bob_widget_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:maxLines="6"
        android:text="등록된 식단이 없어요"
        android:textAlignment="center"
        android:textColor="@android:color/black"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:text="" />

    <TextView
        android:id="@+id/today_bob_widget_hours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="07:00~09:00"
        android:textAlignment="center"
        android:textColor="#8A8A8A"
        android:textSize="9sp" />
</LinearLayout>
